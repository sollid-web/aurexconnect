# ============================================
# AUREXCONNECT — Environment Variables
# ============================================
# Copy this file to .env.local and fill in values

# --- DATABASE (Supabase) ---
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# --- NEXTAUTH ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://aurexconnect.site"

# --- CRON SECRET (protects the ROI engine endpoint) ---
CRON_SECRET="generate-with-openssl-rand-base64-32"

# --- APP ---
NEXT_PUBLIC_APP_NAME="AurexConnect"
NEXT_PUBLIC_APP_URL="https://aurexconnect.site"

# --- EMAIL (Resend) ---
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="AurexConnect <noreply@aurexconnect.site>"
REQUIRE_EMAIL_VERIFICATION="true"

# --- PRIVATE KYC STORAGE (Supabase Storage) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="kyc-documents"
