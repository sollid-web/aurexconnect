# ============================================
# AUREXCONNECT — Environment Variables
# ============================================
# Copy this file to .env.local and fill in values

# --- DATABASE (Neon PostgreSQL) ---
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# --- NEXTAUTH ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://www.aurexconnect.site"

# --- CRON SECRET (protects the ROI engine endpoint) ---
CRON_SECRET="generate-with-openssl-rand-base64-32"

# --- APP ---
NEXT_PUBLIC_APP_NAME="AurexConnect"
NEXT_PUBLIC_APP_URL="https://www.aurexconnect.site"

# --- EMAIL (Resend) ---
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="AurexConnect <noreply@aurexconnect.site>"
REQUIRE_EMAIL_VERIFICATION="true"

# KYC documents are stored in the private Neon `kyc_documents` table.
