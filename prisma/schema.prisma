generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  fullName            String
  phone               String?
  country             String?
  role                UserRole             @default(USER)
  balance             Float                @default(0)
  totalDeposited      Float                @default(0)
  totalProfit         Float                @default(0)
  totalWithdrawn      Float                @default(0)
  referralCode        String               @unique @default(cuid())
  referredBy          String?
  emailVerified       DateTime?            @default(now())
  kycStatus           KycStatus            @default(NONE)
  kycRejectedNote     String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  investments         Investment[]
  kycSubmissions      KycSubmission[]
  notifications       Notification[]
  transactions        Transaction[]
  passwordResetTokens PasswordResetToken[]
  assignedSupportThreads SupportThread[] @relation("SupportThreadAssignee")
  authoredSupportMessages SupportMessage[] @relation("SupportMessageAuthor")
  supportAuditEvents    SupportAuditLog[] @relation("SupportAuditActor")

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Plan {
  id            String       @id @default(cuid())
  name          String       @unique
  roiPercent    Float
  minAmount     Float
  maxAmount     Float?
  durationDays  Int
  referralBonus Float        @default(5)
  isActive      Boolean      @default(true)
  description   String?
  features      String[]     @default([])
  createdAt     DateTime     @default(now())
  investments   Investment[]

  @@map("plans")
}

model Investment {
  id             String           @id @default(cuid())
  userId         String
  planId         String
  amount         Float
  expectedProfit Float
  roiPaid        Float            @default(0)
  lastRoiPaidAt  DateTime?
  status         InvestmentStatus @default(ACTIVE)
  startDate      DateTime         @default(now())
  endDate        DateTime
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  plan           Plan             @relation(fields: [planId], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@map("investments")
}

model Transaction {
  id            String            @id @default(cuid())
  userId        String
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  amount        Float
  currency      String            @default("USD")
  txHash        String?
  proofImageUrl String?
  walletAddress String?
  adminNote     String?
  reviewedBy    String?
  reviewedAt    DateTime?
  note          String?
  createdAt     DateTime          @default(now())
  user          User              @relation(fields: [userId], references: [id])

  @@map("transactions")
}

model KycSubmission {
  id             String    @id @default(cuid())
  userId         String
  documentType   String
  documentNumber String
  frontImageUrl  String
  backImageUrl   String?
  selfieUrl      String
  status         KycStatus @default(PENDING)
  adminNote      String?
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id])

  @@map("kyc_submissions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      String
  targetUserId String
  action       String
  details      String?
  createdAt    DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("admin_audit_logs")
}

model WalletAddress {
  id        String   @id @default(cuid())
  currency  String   @unique
  label     String
  address   String
  network   String   @default("mainnet")
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("wallet_addresses")
}

model RoiProcessingLog {
  id               String   @id @default(cuid())
  processedAt      DateTime @default(now())
  investmentsFound Int
  investmentsDone  Int
  totalProfitPaid  Float
  errors           String?

  @@map("roi_processing_logs")
}

model SupportThread {
  id                String              @id @default(cuid())
  senderEmail       String
  senderName        String?
  subject           String
  status            SupportThreadStatus @default(OPEN)
  assignedAdminId   String?
  lastMessageAt     DateTime            @default(now())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  assignedAdmin     User?               @relation("SupportThreadAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages          SupportMessage[]
  auditEvents       SupportAuditLog[]

  @@index([status, lastMessageAt])
  @@index([assignedAdminId, status])
  @@index([senderEmail])
  @@map("support_threads")
}

model SupportMessage {
  id                String                 @id @default(cuid())
  threadId          String
  direction         SupportMessageDirection
  deliveryStatus    SupportDeliveryStatus  @default(DELIVERED)
  providerEmailId   String?                @unique
  idempotencyKey    String?                @unique
  internetMessageId String?
  inReplyTo         String?
  fromAddress       String
  toAddress         String?
  emailSubject      String?
  replyHeaders      Json?
  textBody          String                 @db.Text
  authorAdminId     String?
  createdAt         DateTime               @default(now())
  thread            SupportThread          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorAdmin       User?                  @relation("SupportMessageAuthor", fields: [authorAdminId], references: [id], onDelete: SetNull)
  attachments       SupportAttachment[]

  @@index([threadId, createdAt])
  @@index([inReplyTo])
  @@index([internetMessageId])
  @@map("support_messages")
}

model SupportAttachment {
  id                  String         @id @default(cuid())
  messageId           String
  providerAttachmentId String
  filename            String
  contentType         String?
  contentDisposition  String?
  contentId           String?
  size                Int?
  createdAt           DateTime       @default(now())
  message             SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, providerAttachmentId])
  @@index([messageId])
  @@map("support_attachments")
}

model SupportAuditLog {
  id            String        @id @default(cuid())
  threadId      String
  actorAdminId  String?
  action        String
  details       String?
  createdAt     DateTime      @default(now())
  thread        SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  actorAdmin    User?         @relation("SupportAuditActor", fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([actorAdminId, createdAt])
  @@map("support_audit_logs")
}

enum UserRole {
  USER
  ADMIN
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PROFIT
  REFERRAL_BONUS
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum InvestmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SupportThreadStatus {
  OPEN
  PENDING
  RESOLVED
}

enum SupportMessageDirection {
  INBOUND
  OUTBOUND
  NOTE
}

enum SupportDeliveryStatus {
  DELIVERED
  QUEUED
  SENT
  FAILED
}
